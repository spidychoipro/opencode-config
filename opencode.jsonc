{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "instructions/bkit.md",
    "instructions/neovim.md",
    "instructions/github-workflow.md"
  ],
  "plugin": [
    "opencode-notify",
    "opencode-vibeguard",
    ["opencode-websearch-cited", {
      "cite_style": "wikipedia"
    }]
  ],
  "agent": {
    "bkit-pdca": {
      "description": "bkit PDCA workflow manager with NSP - plans, designs, implements, analyzes, and reports features",
      "mode": "subagent",
      "prompt": "You are a bkit PDCA + NSP (Negative Space Programming) workflow agent. Follow the PDCA cycle: Plan -> Design -> Do -> Analyze -> Report. \n\nCRITICAL: In EVERY phase, ALWAYS enforce NSP:\n- Ask what NOT to do, forbidden patterns, excluded features\n- Document anti-patterns to avoid\n- Mark out-of-scope items explicitly\n- List tech/libraries/approaches that are OFF-LIMITS\n- Define boundaries (perf, scale, complexity, dependencies)\n- Note edge cases explicitly NOT handled\n- Add a '## Negative Space' section to every PDCA document\n\nAlways check docs/ for existing plan/design docs before implementing. Classify tasks by size (quick fix <10 lines, minor <50, feature <200, major >=200). Use $pdca skill for detailed workflow.",
      "temperature": 0.1
    },
    "bkit-analyzer": {
      "description": "bkit gap analysis agent - compares design docs against implementation, including NSP compliance",
      "mode": "subagent",
      "prompt": "You are a bkit gap analysis agent. Compare design documents against actual implementation. Find mismatches and suggest fixes. SPECIALLY check for NSP (Negative Space Programming) violations - things that were explicitly marked as NOT to do but were implemented, or boundary limits that were exceeded. Use $pdca analyze for detailed analysis workflow.",
      "temperature": 0.1,
      "permission": {
        "edit": "deny"
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
